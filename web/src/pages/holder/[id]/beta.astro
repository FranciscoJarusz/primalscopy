---
import LandingLayout from '@/layouts/LandingLayout.astro';
import PerfilBetaIsland from '@/components/explore/PerfilBetaIsland';
import { backendAbsoluto } from '@/lib/backend';
import { walletCorta } from '@/lib/nicknames';
import type { Perfil } from '@/lib/explore';

export const prerender = false;

const { id = '' } = Astro.params;
if (!/^(0x[0-9a-fA-F]{40}|[A-Za-z0-9_]{3,20})$/.test(id)) return Astro.redirect('/explore');

const respuesta = await fetch(`${backendAbsoluto(Astro.url)}/explore/holder/${id}`).catch(() => null);
if (respuesta?.status === 404) return Astro.redirect('/explore');
const perfil: Perfil | null = respuesta?.ok ? await respuesta.json().catch(() => null) : null;

const nombre = perfil ? perfil.nickname ?? walletCorta(perfil.wallet) : id;
---

<LandingLayout title={`${nombre} (beta) - Primal Cult`} activo="explore" noindex>
    <main class="mt-10 sm:mt-14">
        <PerfilBetaIsland client:only="react" id={id} inicial={perfil} />
    </main>
</LandingLayout>
