---
import LandingLayout from '@/layouts/LandingLayout.astro';
import FichaIsland from '@/components/explore/FichaIsland';
import { BACKEND_URL as BACKEND } from '@/lib/backend';
import type { Ficha } from '@/lib/explore';

export const prerender = false;

const { id = '' } = Astro.params;
if (!/^\d{1,5}$/.test(id) || id.startsWith('0')) return Astro.redirect('/explore');

const local = ['localhost', '127.0.0.1', '[::1]'].includes(Astro.url.hostname);
const origen = local ? Astro.url.origin : `https://${Astro.url.host}`;
const backend = BACKEND.startsWith('/') ? new URL(BACKEND, origen).href : BACKEND;

const respuesta = await fetch(`${backend}/explore/primal/${id}`).catch(() => null);
if (respuesta?.status === 404) return Astro.redirect('/explore');
const ficha: Ficha | null = respuesta?.ok ? await respuesta.json().catch(() => null) : null;

const tarjeta = `${backend}/explore/og/primal/${id}.png`;
fetch(tarjeta).catch(() => {});

const rasgos = ficha?.attributes.map((a) => a.value).join(', ');
const descripcion = ficha
    ? `${ficha.oneOfOne ? '1/1. ' : ''}Rarity rank #${ficha.rank} of ${ficha.total}. ${rasgos}.`
    : `Primal #${id} of the Primal Cult collection on ApeChain.`;
---

<LandingLayout
  title={`Primal #${id} - Primal Cult`}
  description={descripcion}
  activo="explore"
  image={tarjeta}
>
    <main class="mt-10 sm:mt-14">
        <FichaIsland client:only="react" id={id} inicial={ficha} />
    </main>
</LandingLayout>
