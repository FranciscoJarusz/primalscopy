---
import WalletIsland from '@/components/shared/WalletIsland';
import { REDES } from '@/lib/redes';
import { FiArrowUpRight, FiChevronDown } from 'react-icons/fi';

export type Seccion = {
    nombre: string;
    href: string;
    id: string;
    oculta?: boolean;
};

export const SECCIONES: Seccion[] = [
    { id: 'home', nombre: 'Home', href: '/' },
    { id: 'cultomizer', nombre: 'Cultomizer', href: '/cultomizer' },
    { id: 'forge', nombre: 'Forge', href: '/forge' },
    { id: 'raffles', nombre: 'Raffles', href: '/raffles', oculta: true },
];

export const COMMUNITY: Seccion[] = [
    { id: 'stats', nombre: 'Stats', href: '/stats' },
];

interface Props {
    activo?: string;
    secciones?: Seccion[];
}

const { activo = 'home', secciones: todas = SECCIONES } = Astro.props;
const secciones = todas.filter((s) => !s.oculta);
const communityActivo = COMMUNITY.some((s) => s.id === activo);

const clase = (id: string) =>
    id === activo
        ? 'text-yellow'
        : 'text-lightblue hover:text-yellow transition-all duration-300';
---

<header
    class="sticky top-3 sm:top-4 z-30 flex items-center justify-between gap-x-3 px-4 py-3 sm:px-6 sm:py-4 lg:px-10 lg:py-5"
    data-header
>
    <div
        data-fondo
        aria-hidden="true"
        class="absolute inset-x-0 top-0 -z-10 h-full bg-darkblue rounded-2xl sm:rounded-[30px] shadow-lg shadow-darkblue/50 motion-reduce:transition-none"
    ></div>

    <div class="flex items-center gap-6">
        <a
            href="/"
            class="flex items-center gap-3 hover:scale-102 active:scale-97 transition-transform duration-300"
        >
            <img
                src="/brand/logo.svg"
                alt="Primal Cult"
                class="w-22 sm:w-30 h-auto"
            />
        </a>
    </div>

    <nav class="hidden lg:flex items-center justify-center gap-6 xl:gap-10 text-xl uppercase font-accent text-lightblue mb-1">
        {secciones.map((s) => (
            <a
                href={s.href}
                class={
                    s.id === activo
                        ? 'text-yellow'
                        : 'hover:text-yellow transition-all duration-300'
                }
            >
                {s.nombre}
            </a>
        ))}

        <div class="relative" data-desplegable>
            <button
                type="button"
                aria-expanded="false"
                aria-controls="menu-community"
                data-desplegable-boton
                class:list={[
                    'flex items-center gap-1.5 uppercase cursor-pointer',
                    communityActivo
                        ? 'text-yellow'
                        : 'hover:text-yellow aria-expanded:text-yellow transition-all duration-300',
                ]}
            >
                Community
                <span aria-hidden="true" data-desplegable-flecha class="mt-1 flex transition-transform duration-300 motion-reduce:transition-none">
                    <FiChevronDown size={18} />
                </span>
            </button>

            <div
                id="menu-community"
                data-desplegable-panel
                class="absolute left-1/2 top-full -translate-x-1/2 pt-6 invisible opacity-0 -translate-y-1 transition-all duration-200 ease-out motion-reduce:transition-none"
            >
                <div class="min-w-56 bg-darkblue rounded-2xl shadow-lg shadow-darkblue/50 p-2 flex flex-col text-lg">
                    {COMMUNITY.map((s) => (
                        <a
                            href={s.href}
                            tabindex="-1"
                            class={`rounded-lg px-3 pt-1.5 pb-2.5 ${clase(s.id)}`}
                        >
                            {s.nombre}
                        </a>
                    ))}

                    <div class="my-1 mx-3 border-t border-lightblue/15"></div>

                    {REDES.map((red) => (
                        <a
                            href={red.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            tabindex="-1"
                            class="group flex items-center gap-3 rounded-lg px-3 pt-1.5 pb-2.5 text-lightblue hover:text-yellow transition-all duration-300"
                        >
                            <span
                                aria-hidden="true"
                                class="mt-1 size-[20px] shrink-0 bg-current"
                                style={`mask: url(${red.img}) center / contain no-repeat`}
                            ></span>
                            <span class="flex-1">{red.nombre}</span>
                            <span
                                aria-hidden="true"
                                class="flex mt-1 opacity-50 group-hover:opacity-100 transition-opacity duration-300"
                            >
                                <FiArrowUpRight size={16} />
                            </span>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <slot name="derecha">
            <WalletIsland
                client:load
                dato={activo === 'raffles' ? 'saldo' : 'primals'}
            />
        </slot>

        <button
            type="button"
            aria-expanded="false"
            aria-controls="menu-secciones"
            aria-label="Abrir menu"
            data-menu-toggle
            class="lg:hidden cursor-pointer rounded-lg text-lightblue hover:text-yellow transition-colors duration-300"
        >
            <span class="relative block w-5 h-5" aria-hidden="true">
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    data-icono="abrir"
                    class="absolute inset-0 transition-all duration-300 ease-out motion-reduce:transition-none opacity-100"
                >
                    <line x1="3" y1="6" x2="17" y2="6"></line>
                    <line x1="3" y1="10" x2="17" y2="10"></line>
                    <line x1="3" y1="14" x2="17" y2="14"></line>
                </svg>

                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    data-icono="cerrar"
                    class="absolute inset-0 transition-all duration-300 ease-out motion-reduce:transition-none opacity-0 -rotate-90 scale-75"
                >
                    <line x1="5" y1="5" x2="15" y2="15"></line>
                    <line x1="15" y1="5" x2="5" y2="15"></line>
                </svg>
            </span>
        </button>
    </div>

    <div
        data-menu-caja
        class="lg:hidden absolute inset-x-0 top-full -mt-px invisible pointer-events-none [clip-path:inset(0_0_100%_0)]"
    >
        <div>
            <nav
                id="menu-secciones"
                aria-hidden="true"
                data-menu-nav
                class="mx-4 sm:mx-6 border-t border-lightblue/15 pt-3 pb-3 sm:pb-4 flex flex-col gap-1 font-accent uppercase text-lg motion-reduce:transition-none opacity-0"
            >
                {secciones.map((s) => (
                    <a
                        href={s.href}
                        tabindex="-1"
                        class={`rounded-lg px-3 pt-1.5 pb-2.5 ${clase(s.id)}`}
                    >
                        {s.nombre}
                    </a>
                ))}

                {/* En mobile Community no se anida: es una seccion con titulo. */}
                <p class="mt-1 border-t border-lightblue/15 px-3 pt-3 pb-1 text-sm text-lightblue/50">
                    Community
                </p>

                {COMMUNITY.map((s) => (
                    <a
                        href={s.href}
                        tabindex="-1"
                        class={`rounded-lg px-3 pt-1.5 pb-2.5 ${clase(s.id)}`}
                    >
                        {s.nombre}
                    </a>
                ))}

                {REDES.map((red) => (
                    <a
                        href={red.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        tabindex="-1"
                        class="flex items-center gap-3 rounded-lg px-3 pt-1.5 pb-2.5 text-lightblue hover:text-yellow transition-all duration-300"
                    >
                        <span
                                aria-hidden="true"
                                class="mt-1 size-[18px] shrink-0 bg-current"
                                style={`mask: url(${red.img}) center / contain no-repeat`}
                            ></span>
                        <span>{red.nombre}</span>
                        <span aria-hidden="true" class="flex mt-1 opacity-50">
                            <FiArrowUpRight size={14} />
                        </span>
                    </a>
                ))}

                <button
                    type="button"
                    tabindex="-1"
                    data-menu-logout
                    class="hidden in-data-wallet:flex items-center gap-2 mt-1 border-t border-lightblue/15 px-3 pt-2.5 pb-2.5 font-accent uppercase text-lightblue hover:text-yellow cursor-pointer transition-all duration-300"
                >
                    <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path d="M21,7V17a5.006,5.006,0,0,1-5,5H12a1,1,0,0,1,0-2h4a3,3,0,0,0,3-3V7a3,3,0,0,0-3-3H12a1,1,0,0,1,0-2h4A5.006,5.006,0,0,1,21,7Zm-6.293,4.293-4-4A1,1,0,1,0,9.293,8.707L11.586,11H4a1,1,0,0,0,0,2h7.586L9.293,15.293a1,1,0,1,0,1.414,1.414l4-4A1,1,0,0,0,14.707,11.293Z" />
                    </svg>
                    <span class="pb-1">Log out</span>
                </button>
            </nav>
        </div>
    </div>
</header>

<script>
    const header = document.querySelector<HTMLElement>('[data-header]');
    if (header) {
        const boton =
            header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
        const caja = header.querySelector<HTMLElement>('[data-menu-caja]');
        const nav = header.querySelector<HTMLElement>('[data-menu-nav]');
        const abrir = header.querySelector<HTMLElement>('[data-icono="abrir"]');
        const cerrar = header.querySelector<HTMLElement>(
            '[data-icono="cerrar"]'
        );

        let abierto = false;
        const fondo = header.querySelector<HTMLElement>('[data-fondo]');

        const CURVA_ABRIR = '420ms cubic-bezier(0.22, 1, 0.36, 1)';
        const CURVA_CERRAR = '320ms cubic-bezier(0.4, 0, 0.2, 1)';
        const ABRIR = 'height ' + CURVA_ABRIR;
        const CERRAR = 'height ' + CURVA_CERRAR;

        const altoAbierto = () =>
            header.offsetHeight + (caja?.offsetHeight ?? 0);

        const pintar = () => {
            boton?.setAttribute('aria-expanded', String(abierto));
            boton?.setAttribute(
                'aria-label',
                abierto ? 'Cerrar menu' : 'Abrir menu'
            );

            if (fondo) {
                fondo.style.height = fondo.offsetHeight + 'px';
                void fondo.offsetHeight;
                fondo.style.transition = abierto ? ABRIR : CERRAR;
                fondo.style.height =
                    (abierto ? altoAbierto() : header.offsetHeight) + 'px';
            }

            if (caja) {
                caja.style.transition = abierto
                    ? `clip-path ${CURVA_ABRIR}, visibility 0s`
                    : `clip-path ${CURVA_CERRAR}, visibility 0s linear 320ms`;
                caja.style.clipPath = abierto
                    ? 'inset(0 0 0 0)'
                    : 'inset(0 0 100% 0)';
            }
            caja?.classList.toggle('invisible', !abierto);
            caja?.classList.toggle('pointer-events-none', !abierto);

            if (nav) {
                nav.style.transition = abierto
                    ? 'opacity 300ms ease-out 60ms'
                    : 'opacity 200ms ease-in';
            }
            nav?.setAttribute('aria-hidden', String(!abierto));
            nav?.classList.toggle('opacity-100', abierto);
            nav?.classList.toggle('opacity-0', !abierto);
            nav?.querySelectorAll('a, button').forEach((el) => {
                (el as HTMLElement).tabIndex = abierto ? 0 : -1;
            });

            abrir?.classList.toggle('opacity-0', abierto);
            abrir?.classList.toggle('rotate-90', abierto);
            abrir?.classList.toggle('scale-75', abierto);
            abrir?.classList.toggle('opacity-100', !abierto);

            cerrar?.classList.toggle('opacity-100', abierto);
            cerrar?.classList.toggle('opacity-0', !abierto);
            cerrar?.classList.toggle('-rotate-90', !abierto);
            cerrar?.classList.toggle('scale-75', !abierto);
        };

        fondo?.addEventListener('transitionend', () => {
            if (!abierto) {
                fondo.style.height = '';
                fondo.style.transition = '';
            }
        });

        window.addEventListener('resize', () => {
            if (abierto && fondo) {
                fondo.style.transition = 'none';
                fondo.style.height = altoAbierto() + 'px';
            }
        });

        boton?.addEventListener('click', () => {
            abierto = !abierto;
            pintar();
        });

        nav?.querySelectorAll('a').forEach((a) =>
            a.addEventListener('click', () => {
                abierto = false;
                pintar();
            })
        );

        header
            .querySelector('[data-menu-logout]')
            ?.addEventListener('click', () => {
                window.dispatchEvent(new CustomEvent('primal:logout'));
                abierto = false;
                pintar();
            });

        document.addEventListener('click', (e) => {
            if (abierto && !header.contains(e.target as Node)) {
                abierto = false;
                pintar();
            }
        });

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && abierto) {
                abierto = false;
                pintar();
            }
        });

        const desplegable =
            header.querySelector<HTMLElement>('[data-desplegable]');
        const dBoton = desplegable?.querySelector<HTMLButtonElement>(
            '[data-desplegable-boton]'
        );
        const dPanel = desplegable?.querySelector<HTMLElement>(
            '[data-desplegable-panel]'
        );
        const dFlecha = desplegable?.querySelector<HTMLElement>(
            '[data-desplegable-flecha]'
        );

        if (desplegable && dBoton && dPanel) {
            let dAbierto = false;
            let porHover = false;
            let espera: number | undefined;

            const dPintar = (valor: boolean) => {
                dAbierto = valor;
                if (!valor) porHover = false;
                dBoton.setAttribute('aria-expanded', String(valor));
                dPanel.classList.toggle('invisible', !valor);
                dPanel.classList.toggle('opacity-0', !valor);
                dPanel.classList.toggle('-translate-y-1', !valor);
                dFlecha?.classList.toggle('rotate-180', valor);
                dPanel.querySelectorAll('a').forEach((a) => {
                    a.tabIndex = valor ? 0 : -1;
                });
            };

            desplegable.addEventListener('pointerenter', (e) => {
                if (e.pointerType !== 'mouse') return;
                clearTimeout(espera);
                if (!dAbierto) {
                    porHover = true;
                    dPintar(true);
                }
            });

            desplegable.addEventListener('pointerleave', (e) => {
                if (e.pointerType !== 'mouse') return;
                espera = window.setTimeout(() => dPintar(false), 150);
            });

            dBoton.addEventListener('click', () => {
                if (porHover) {
                    porHover = false;
                    return;
                }
                dPintar(!dAbierto);
            });

            desplegable.addEventListener('focusout', (e) => {
                if (!desplegable.contains(e.relatedTarget as Node)) {
                    dPintar(false);
                }
            });

            document.addEventListener('click', (e) => {
                if (dAbierto && !desplegable.contains(e.target as Node)) {
                    dPintar(false);
                }
            });

            desplegable.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && dAbierto) {
                    dPintar(false);
                    dBoton.focus();
                }
            });
        }
    }
</script>
