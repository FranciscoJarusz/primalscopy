---
const periodos = [
    { days: 7, perDay: 40 },
    { days: 14, perDay: 44 },
    { days: 30, perDay: 52 },
    { days: 90, perDay: 64 },
];
---

<section class="lg:min-h-100 flex flex-col gap-6 sm:gap-10 lg:gap-15">
    <div class="flex flex-col lg:flex-row items-stretch justify-between gap-6 lg:gap-10 xl:gap-20">
        <picture class="contents">
            <source
                media="(max-width: 1023px)"
                srcset="/images/landing/staking-m.webp"
            />
            <img
                data-anim="reveal-left"
                src="/images/landing/staking.webp"
                alt="Primal Cult Staking"
                loading="lazy"
                decoding="async"
                class="order-last lg:order-0 aspect-4/3 lg:aspect-auto h-auto lg:min-h-full w-full lg:w-[45%] rounded-2xl sm:rounded-[30px] object-cover object-center shadow-lg shadow-darkblue/50"
            />
        </picture>

        <div
            data-anim="reveal-right"
            class="flex w-full lg:w-[50%] flex-col justify-between gap-6 lg:gap-10 rounded-2xl sm:rounded-[30px] bg-darkblue p-6 sm:p-8 lg:p-10 xl:p-12.5 shadow-lg shadow-darkblue/50"
        >
            <h2 class="max-w-4xl text-5xl sm:text-6xl xl:text-7xl font-accent uppercase text-yellow">
                SOFT STAKING
            </h2>

            <div class="flex max-w-lg flex-col gap-2 text-base sm:text-lg text-lightblue">
                <p>
                    Stake your Primals on the website and earn FOG every day.
                    No gas, and they never leave your wallet.
                </p>
                <p>
                    Pick 7, 14, 30 or 90 days: the longer you stake, the more
                    FOG you earn. Holding more Primals adds an extra bonus.
                </p>
                <p>
                    Spend your FOG in the Shop on keys, raffle tickets, rerolls
                    and more.
                </p>

                <a
                    href="/staking"
                    class="mt-2 w-fit bg-yellow text-darkblue font-accent uppercase px-6 pt-2 pb-3.5 rounded-[10px] hover:scale-102 active:scale-97 transition-all duration-300"
                >
                    Start staking
                </a>
            </div>
        </div>
    </div>

    <ul
        data-anim-stagger
        class="grid grid-cols-2 lg:grid-cols-4 gap-4"
        aria-label="Staking periods"
    >
        {periodos.map((p) => (
            <li
                data-periodo={p.days}
                class="flex flex-col items-center justify-center gap-2 lg:gap-3 rounded-2xl sm:rounded-3xl bg-darkblue px-3 sm:px-6 pt-1 pb-4 text-center text-yellow shadow-lg shadow-darkblue/50"
            >
                <p class="font-accent uppercase text-3xl sm:text-4xl xl:text-5xl 2xl:text-6xl">{p.days} days</p>
                <span class="text-sm sm:text-base font-bold uppercase">
                    <span data-fog>{p.perDay}</span> FOG a day
                </span>
            </li>
        ))}
    </ul>
</section>

<script>
    import { BACKEND_URL } from '@/lib/backend';

    (async () => {
        try {
            const response = await fetch(`${BACKEND_URL}/staking/config`);
            if (!response.ok) return;
            const { periods } = await response.json();
            if (!Array.isArray(periods)) return;
            for (const periodo of periods) {
                const fog = document.querySelector<HTMLElement>(`[data-periodo="${periodo.days}"] [data-fog]`);
                if (fog && Number.isFinite(periodo.perDay)) fog.textContent = periodo.perDay.toLocaleString('en-US');
            }
        } catch {}
    })();
</script>
