---
const team = [
    {
        slug: 'troutxyz',
        name: 'Troutxyz',
        role: 'Artist & Founder',
        link: 'https://x.com/troutxyz',
    },
    {
        slug: 'torch',
        name: 'Torch',
        role: 'Project Coordinator & Strategist',
        link: 'https://x.com/we_are_torch',
    },
    {
        slug: 'gorty',
        name: 'Gorty',
        role: 'Vault & Events Manager',
        link: 'https://x.com/Thebar111',
    },
    {
        slug: 'fransz',
        name: 'Fransz',
        role: 'Main Developer',
        link: 'https://x.com/franszdev',
    },
    {
        slug: 'sal',
        name: 'Sal',
        role: 'Discord Moderator & Community Manager',
        link: 'https://x.com/RealBigDaddySal',
    },
];
---

<section
    data-anim="reveal"
    class="flex w-full flex-col gap-6 sm:gap-10 xl:gap-15 rounded-2xl sm:rounded-[30px] bg-darkblue p-6 sm:p-8 lg:p-10 xl:p-12.5 shadow-lg shadow-darkblue/50"
>
    <h2 class="max-w-4xl text-5xl sm:text-6xl xl:text-7xl font-accent uppercase text-yellow">
        The inner council
    </h2>

    <ul
        data-anim-stagger
        class="grid grid-cols-1 min-[420px]:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 xl:gap-8"
        aria-label="Team"
    >
        {team.map((member) => (
            <li class="flex flex-col items-center gap-3 sm:gap-4 rounded-2xl sm:rounded-[30px] bg-[#0a0a5c] p-4 sm:p-6">
                <img
                    src={`/images/team/${member.slug}.webp`}
                    alt={member.name}
                    class="aspect-square w-full rounded-2xl object-cover"
                    loading="lazy"
                />
                <div class="flex flex-col items-center gap-2 sm:gap-3 text-center">
                    <span class="font-accent text-3xl sm:text-4xl uppercase text-yellow">
                        {member.name}
                    </span>
                    <span class="text-xs sm:text-sm font-bold uppercase text-lightblue text-balance">
                        {member.role}
                    </span>
                </div>
                <a
                    href={member.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={member.name}
                    class="w-5 h-auto hover:scale-102 active:scale-97 transition-all duration-300"
                >
                    <img src="/icons/x.svg" alt="Logo X" />
                </a>
            </li>
        ))}
    </ul>
</section>
