---
const initialStats = [
    { value: '2,713', label: 'Primals', id: 'primals-count' },
    { value: '1,013.95', label: '$APE burned', id: 'ape-burned' },
    { value: '636', label: 'Cultists', id: 'holders-count' },
];
---

<section
    data-anim-stagger
    class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:flex lg:items-center lg:justify-between"
    aria-label="Primal Cult stats"
>
    {initialStats.map((stat) => (
        <div
            data-exiled={stat.id === 'primals-count' ? '' : undefined}
            class:list={[
                'flex flex-col items-center justify-center gap-2 lg:gap-3 rounded-2xl sm:rounded-3xl bg-darkblue px-6 lg:px-12 pt-1 pb-4 text-center text-yellow shadow-lg shadow-darkblue/50',
                stat.id === 'primals-count' && 'select-none',
            ]}
        >
            <p id={stat.id} data-supply={stat.id === 'primals-count' ? '' : undefined} class="font-accent text-5xl sm:text-4xl lg:text-6xl">
                {stat.value}
            </p>
            <span class="text-sm sm:text-base font-bold uppercase">{stat.label}</span>
        </div>
    ))}
</section>

<script>
    const burned = document.querySelector<HTMLElement>('#ape-burned');
    const holders = document.querySelector<HTMLElement>('#holders-count');

    if (burned) {
        const refreshBurned = async () => {
            try {
                const response = await fetch('/api/stats/burned');
                if (!response.ok) return;

                const data = await response.json();
                if (typeof data.value === 'number') {
                    burned.textContent = data.value.toLocaleString('en-US', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2,
                    });
                }
            } catch {}
        };

        refreshBurned();
        window.setInterval(refreshBurned, 5 * 60 * 1000);
    }

    const refreshCollection = async () => {
        try {
            const response = await fetch('/api/stats/holders');
            if (!response.ok) return;

            const data = await response.json();
            if (Number.isInteger(data.totalSupply) && data.totalSupply > 0) {
                const texto = data.totalSupply.toLocaleString('en-US');
                document.querySelectorAll<HTMLElement>('[data-supply]').forEach((n) => {
                    n.dataset.supply = String(data.totalSupply);
                    if (!n.classList.contains('exiled-rojo')) n.textContent = texto;
                });
            }
            if (holders && Number.isInteger(data.holders) && data.holders > 0) {
                holders.textContent = data.holders.toLocaleString('en-US');
            }
        } catch {}
    };

    refreshCollection();
</script>
