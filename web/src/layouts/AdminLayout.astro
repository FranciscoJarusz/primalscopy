---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/shared/Header.astro';
import Footer from '@/components/shared/Footer.astro';

interface Props {
    title?: string;
}

// Las pestañas de las secciones las dibuja AdminApp, recien despues de entrar.
const { title = 'Admin - Primal Cult' } = Astro.props;
---

<BaseLayout title={title} noindex>
    <div class="min-h-dvh flex flex-col gap-6 sm:gap-10 px-4 py-3 sm:px-8 sm:py-6 lg:px-16 xl:px-30 lg:py-10">
        <Header activo="" />

        <div class="flex-1 flex flex-col">
            <slot />
        </div>
        <Footer />
    </div>
</BaseLayout>
