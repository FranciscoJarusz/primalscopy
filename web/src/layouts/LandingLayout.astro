---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/shared/Header.astro";
import Footer from "@/components/shared/Footer.astro";

interface Props {
  title?: string;
  activo?: string;
}

const { title = "Primal Cult", activo = "home" } = Astro.props;
---

<BaseLayout title={title}>
  <div class="min-h-screen flex flex-col px-4 py-3 sm:px-8 sm:py-6 lg:px-16 xl:px-30 lg:py-10">
    <Header activo={activo} />
    <slot />  
    <Footer class="mt-20" />
  </div>  
</BaseLayout>
