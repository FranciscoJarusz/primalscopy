---
import "../styles/global.css";

// La cascara comun a cualquier pagina del sitio: fuente, favicon, fondo. No
// sabe nada de raffles ni de wallets — eso lo agrega cada layout especifico
// (por ejemplo RafflesLayout) envolviendo a este.
interface Props {
  title?: string;
  // El texto que muestran Google y la tarjeta al compartir el link.
  description?: string;
  // Paginas internas (admin) o que solo sirven con wallet conectada: que los
  // buscadores no las indexen.
  noindex?: boolean;
}

const DESCRIPCION =
  "2,712 Primals. Ancient gorillas, shrouded in mystery, bearers of forbidden symbols, weaving chaos into glitch. One of the first glitch collections on ApeChain.";

const { title = "Primal Cult", description = DESCRIPCION, noindex = false } = Astro.props;

// Siempre el dominio principal (site en astro.config), aunque se entre por
// cultomizer.primalcult.xyz o un preview: Google junta todo en una sola URL.
// Sin la barra final que agrega el build (/forge/): igual que los links del
// sitio y el sitemap.
const ruta = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonica = new URL(ruta, Astro.site).href;
const imagen = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0066" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonica} />}

    <!-- La tarjeta que arman X, Discord, Telegram y WhatsApp al pegar el link. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Primal Cult" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagen} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Antes de pintar: esconde lo que se va a animar (ver lib/animaciones.ts)
         para que no aparezca y desaparezca. Si el JS no llega a sacar la
         clase, se saca sola: el contenido nunca queda invisible. -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("anim-pendiente");
        setTimeout(function () {
          document.documentElement.classList.remove("anim-pendiente");
        }, 3000);
      }
    </script>
  </head>

  <body
    class="min-h-screen"
  >
    <slot />

    <script>
      import { initLenis } from "@/lib/lenis";
      const lenis = initLenis();

      // En todas las paginas, aunque al cargar no haya nada marcado: las
      // islas de React arman su HTML despues. Va en un chunk aparte para no
      // demorar el resto de la pagina.
      import("@/lib/animaciones")
        .then(({ initAnimaciones }) => initAnimaciones(lenis))
        .catch(() => document.documentElement.classList.remove("anim-pendiente"));
    </script>
  </body>
</html>
