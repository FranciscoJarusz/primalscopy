---
import "../styles/global.css";

// La cascara comun a cualquier pagina del sitio: fuente, favicon, fondo. No
// sabe nada de raffles ni de wallets — eso lo agrega cada layout especifico
// (por ejemplo RafflesLayout) envolviendo a este.
interface Props {
  title?: string;
  // Paginas internas (admin): que los buscadores no las indexen.
  noindex?: boolean;
}

const { title = "Primal Cult", noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body
    class="min-h-screen"
  >
    <slot />

    <script>
      import { initLenis } from "@/lib/lenis";
      initLenis();
    </script>
  </body>
</html>
