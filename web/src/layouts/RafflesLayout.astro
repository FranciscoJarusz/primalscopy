---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/shared/Header.astro";
import CuentaDemo from "@/components/raffles/CuentaDemo";
import Footer from "@/components/shared/Footer.astro";
import { shortAddress } from "@/lib/raffles/format";
import { HUB } from "@/lib/raffles/contrato";

interface Props {
  title?: string;
  activo?: string;
}

const { title = "Raffles - Primal Cult", activo = "raffles" } = Astro.props;
---

<BaseLayout title={title}>
  {/* El header es HTML plano; lo unico que hidrata es el selector de cuenta,
      y con client:load y no client:only para que se vea enseguida. */}
  <Header activo={activo}>
    <CuentaDemo client:load slot="derecha" />
  </Header>

  <div class=" mx-auto px-4 py-8 sm:px-8 flex flex-col gap-12">
    <slot />

    <Footer />

    <p class="text-center text-white/25 text-xs -mt-6">
      Running on a local chain with fake APE &middot; hub at {shortAddress(HUB)}
    </p>
  </div>
</BaseLayout>
