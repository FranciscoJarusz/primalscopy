---
import BaseLayout from "./BaseLayout.astro";
import RafflesHeader from "../components/raffles/RafflesHeader";
import Footer from "../components/shared/Footer";
import { shortAddress } from "../lib/raffles/format";
import { HUB } from "../lib/raffles/contrato";

interface Props {
  title?: string;
  activo?: string;
}

const { title = "Raffles - Primal Cult", activo = "raffles" } = Astro.props;
---

<BaseLayout title={title}>
  {/* client:load y no client:only: el header se ve enseguida, sin esperar a
      que el navegador lea la cadena. */}
  <RafflesHeader client:load activo={activo} />

  <div class="max-w-7xl mx-auto px-4 py-8 sm:px-8 flex flex-col gap-12">
    <slot />

    <Footer />

    <p class="text-center text-white/25 text-xs -mt-6">
      Running on a local chain with fake APE &middot; hub at {shortAddress(HUB)}
    </p>
  </div>
</BaseLayout>
