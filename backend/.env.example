# Copiá este archivo a .env para desarrollo local.
# En Railway estas variables se cargan desde el dashboard, no desde un archivo.

# Dónde viven los traits.
# Local: una carpeta cualquiera fuera del repo de assets.
# Railway: el mount path del volumen (ej: /data/traits).
TRAITS_PATH=./.local-traits

# Contraseña del panel de admin.
# Sin esto, /api/admin/* responde 503 y el panel no funciona.
# Para producción generá uno largo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=dev-token-local

# Tokens que pueden usar TODOS los traits de cada categoria, no solo los de su
# tipo (ej: UNLOCKED_TOKENS=54). Temporal: se customiza y se vuelve a vaciar.
# Vacio no cambia nada. Guardar sigue exigiendo ser el dueño del token.
UNLOCKED_TOKENS=

# Forge: rolls pagos que cambian los traits de un NFT.
#
# Cobro: cada roll se paga transfiriendo APE (ApeChain) a FORGE_TREASURY. Sin
# FORGE_TREASURY y FORGE_ROLL_PRICE no se cobra, y el Forge solo abre en modo
# de prueba (con rolls gratis).
FORGE_TREASURY=
# Precio de un roll en APE, ej. 5 o 0.5.
FORGE_ROLL_PRICE=
# Bloque de ApeChain desde el que se aceptan pagos: poner el bloque actual al
# abrir el Forge. Si queda en 0, cualquier transferencia vieja de esa wallet al
# treasury contaria como pago de un roll.
FORGE_PAYMENTS_FROM_BLOCK=
# Bloques de espera antes de aceptar un pago (default 2).
FORGE_CONFIRMATIONS=

# Modo de prueba: en "true" los cambios quedan SOLO en este server: nunca se
# publican en el hosting de la coleccion ni se avisa a OpenSea. Si ademas no
# hay cobro configurado, los rolls son gratis. Los NFTs tocados quedan
# bloqueados para publicar hasta correr:
#   node --env-file-if-exists=.env scripts/forge-reset-sandbox.js
# Nunca en "true" en produccion.
FORGE_TEST_MODE=
