# Copiá este archivo a .env para desarrollo local.
# En Railway estas variables se cargan desde el dashboard, no desde un archivo.
# Las que tienen valor por defecto se pueden dejar vacías.

# --- Lo básico ----------------------------------------------------------------

# Dónde viven los traits.
# Local: una carpeta cualquiera fuera del repo de assets.
# Railway: el mount path del volumen (ej: /data/traits).
TRAITS_PATH=./.local-traits

# Contraseña del panel de admin.
# Sin esto, /api/admin/* responde 503 y el panel no funciona.
# Para producción generá uno largo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=dev-token-local

# Secreto para firmar las sesiones de wallet (el login por firma).
# Sin esto, /api/auth/* y todo lo que pide sesión (guardar en el Cultomizer, el
# Forge, el staking, los códigos, los apodos) responde 503. Se genera igual que
# ADMIN_TOKEN. Cambiarlo cierra todas las sesiones abiertas.
WALLET_JWT_SECRET=

# El dominio que aparece en el mensaje que firma el usuario. Default:
# primalcult.xyz.
APP_DOMAIN=

# Puerto del server. Railway lo define solo. Default: 3001.
PORT=

# --- La colección -------------------------------------------------------------

# Contrato de la colección en ApeChain. Default: el de Primal Cult.
NFT_CONTRACT_ADDRESS=

# Bloque donde se creó el contrato: desde ahí se leen las transferencias
# (lib/transferIndex.js). Default: 7252166, el de Primal Cult.
NFT_FROM_BLOCK=

# RPC de ApeChain (Alchemy, QuickNode, etc.). Pueden ir varios separados por
# coma; el público (rpc.apechain.com) queda siempre de respaldo al final.
# Vacío: solo el público.
APECHAIN_RPC_URL=

# De dónde se lee la metadata vigente de cada NFT (el hosting de la colección).
# Default: https://ipfs.primalcult.xyz/metadata/
# Ojo: esta es la única que vacía NO usa el default, desactiva la consulta. Es
# lo que corresponde el día que ipfs.primalcult.xyz apunte a este mismo server;
# mientras tanto, dejala comentada.
# ORIGIN_METADATA_URL=

# De dónde se bajan las imágenes de la colección (miniaturas del mapa de
# staking y la migración de archivos). Default: https://ipfs.primalcult.xyz
ORIGIN_ASSETS_URL=

# La URL pública que queda en el campo "image" de la metadata al publicar.
# Default: https://ipfs.primalcult.xyz
PUBLIC_ASSETS_URL=

# Publicar en el hosting de la colección (por SFTP). Sin estas, guardar en el
# Cultomizer o elegir en el Forge queda solo en este server y no se ve en
# ninguna wallet. En local van vacías: con las de producción, guardar desde tu
# máquina publicaría de verdad.
SFTP_HOST=
SFTP_PORT=
SFTP_USER=
SFTP_PASSWORD=
SFTP_REMOTE_ROOT=

# Rango de tokens de la migración de archivos al volumen (panel de admin).
# Default: 1 a 2712.
SEED_FIRST_TOKEN=
SEED_LAST_TOKEN=

# --- OpenSea ------------------------------------------------------------------

# Para pedirle a OpenSea que refresque un NFT después de publicarlo, y para
# detectar los Primals listados (un Primal listado sale del staking). Sin esto
# no se refresca nada y el staking no ve los listados.
OPENSEA_API_KEY=
# Defaults: ape_chain y primalcult.
OPENSEA_CHAIN=
OPENSEA_COLLECTION_SLUG=

# --- Cultomizer ---------------------------------------------------------------

# Cuántas customizaciones guarda "Recent Customizations". Default: 1000.
FEED_MAX_ITEMS=

# Tokens que pueden usar TODOS los traits de cada categoria, no solo los de su
# tipo (ej: UNLOCKED_TOKENS=54). Temporal: se customiza y se vuelve a vaciar.
# Vacio no cambia nada. Guardar sigue exigiendo ser el dueño del token.
UNLOCKED_TOKENS=

# --- Forge --------------------------------------------------------------------

# Cobro: cada roll se paga transfiriendo APE (ApeChain) a FORGE_TREASURY. Sin
# FORGE_TREASURY y FORGE_ROLL_PRICE no se cobra, y el Forge solo abre en modo
# de prueba (con rolls gratis).
FORGE_TREASURY=
# Precio de un roll en APE, ej. 5 o 0.5.
FORGE_ROLL_PRICE=
# Bloque de ApeChain desde el que se aceptan pagos: poner el bloque actual al
# abrir el Forge. Si queda en 0, cualquier transferencia vieja de esa wallet al
# treasury contaria como pago de un roll.
FORGE_PAYMENTS_FROM_BLOCK=
# Bloques de espera antes de aceptar un pago (default 2).
FORGE_CONFIRMATIONS=
# Otra cadena para los pagos, para probar contra anvil.
# Defaults: el RPC público y el chain id de ApeChain.
FORGE_RPC_URL=
FORGE_CHAIN_ID=

# Modo de prueba: en "true" los cambios quedan SOLO en este server: nunca se
# publican en el hosting de la coleccion ni se avisa a OpenSea. Si ademas no
# hay cobro configurado, los rolls son gratis. Los NFTs tocados quedan
# bloqueados para publicar hasta correr:
#   node --env-file-if-exists=.env scripts/forge-reset-sandbox.js
# Nunca en "true" en produccion.
FORGE_TEST_MODE=
