# Copiá este archivo a .env para desarrollo local.
# En Railway estas variables se cargan desde el dashboard, no desde un archivo.

# Dónde viven los traits.
# Local: una carpeta cualquiera fuera del repo de assets.
# Railway: el mount path del volumen (ej: /data/traits).
TRAITS_PATH=./.local-traits

# Contraseña del panel de admin.
# Sin esto, /api/admin/* responde 503 y el panel no funciona.
# Para producción generá uno largo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=dev-token-local
