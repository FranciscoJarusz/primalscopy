# Variables de entorno para PrimaCult Customizer
# Copia este archivo a .env.local y configura los valores

# Base de datos
DATABASE_URL="file:./prisma/dev.db"

# Contrato de PrimaCult (REEMPLAZAR CON LA DIRECCIÓN REAL)
PRIMACULT_CONTRACT_ADDRESS="0x1234567890123456789012345678901234567890"

# RPC de Ethereum (REEMPLAZAR CON TU ENDPOINT)
ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/YOUR_PROJECT_ID"

# NextAuth
NEXTAUTH_SECRET="tu-secret-super-seguro-aqui"
NEXTAUTH_URL="http://localhost:3000"

# Pantalla de customizaciones recientes.
# En "true" aparece el boton que lleva a /recent desde el customizer. Sin esta
# variable la pantalla funciona igual, pero solo para el que tenga el link.
NEXT_PUBLIC_SHOW_RECENT_FEED="false"

# Backend del customizer
NEXT_PUBLIC_BACKEND_URL="http://localhost:3001/api"
NEXT_PUBLIC_BACKEND_BASE_URL="http://localhost:3001"

# Ejemplos de RPC URLs:
# Infura Mainnet: https://mainnet.infura.io/v3/TU_PROJECT_ID
# Alchemy Mainnet: https://eth-mainnet.g.alchemy.com/v2/TU_API_KEY
# Sepolia Testnet: https://sepolia.infura.io/v3/TU_PROJECT_ID
# Polygon: https://polygon-rpc.com

